<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_input_template_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.input.template.tree</field>
        <field name="model">hr.payslip.input.template</field>
        <field name="arch" type="xml">
            <tree name="Payslip Input">
                <field name="name" placeholder="Payslip Input Name" />
                <field name="code" />
                <field name="struct_ids" widget="many2many_tags" />
            </tree>
        </field>
    </record>

    <record id="hr_payslip_input_template_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.input.template.form</field>
        <field name="model">hr.payslip.input.template</field>
        <field name="arch" type="xml">
            <form string="Payslip Input">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="code" />
                        </group>
                        <group>
                            <field name="struct_ids" widget="many2many_tags" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_payslip_input_template_view_action" model="ir.actions.act_window">
        <field name="name">Other Input Templates</field>
        <field name="res_model">hr.payslip.input.template</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
</odoo>
