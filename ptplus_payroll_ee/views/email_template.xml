<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!--Email template -->
        <record id="email_template_edi_hr_payroll_pt" model="mail.template">
            <field name="name">Payslip - Send Payslip by mail PT</field>
            <field name="subject"> ${object.name or 'n/a' }</field>
            <field
                name="email_from"
            >${object.employee_id.user_id.partner_id.email}</field>
            <field name="email_to">${object.employee_id.private_email}</field>
            <field name="partner_to">${object.employee_id.user_id.partner_id.id}</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip" />
            <field name="auto_delete" eval="False" />
            <field name="lang">pt_PT</field>
            <field name="report_template" ref="ptplus_payroll.action_report_payslip_pt" />
            <field name="report_name">${(object.name or '').replace('/','-')}</field>
            <field
                name="body_html"
            ><![CDATA[
                <div style="font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; ">
                    <p>Olá Caro(a) ${object.employee_id.name},</p>
                    <p>Por favor, encontre em anexo o seu ${object.name or 'n/a'} da ${object.company_id.name}.</p>

                    <p>Se tiver alguma dúvida, não hesite em contactar o RH.</p><br/>
                    <p>Obrigado(a).</p>
                    <p>Departamento de RH.</p>
                    <p>${object.company_id.name}</p>
                </div>
            ]]></field>
        </record>
    </data>
</odoo>
