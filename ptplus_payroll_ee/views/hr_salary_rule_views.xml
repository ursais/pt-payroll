<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_salary_rule_form_pt" model="ir.ui.view">
        <field name="name">hr.salary.rule.pt</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form" />
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="country_code" invisible="1" />
                <field name="l10n_pt_standard_rule" invisible="1" />
                <field name="l10n_pt_category_code" invisible="1" />
            </field>
            <xpath expr="//notebook" position="inside">
                <page
                    name="pt_rule_information"
                    string="PT Rule Information"
                    invisible="country_code != 'PT'"
                >
                    <group>
                        <group string="Codes for Tax Returns">
                            <field name="l10n_pt_dri_subject_amount" />
                            <field name="l10n_pt_dmr_subject_amount" />
                            <field name="l10n_pt_dmr_exempt_amount" />
                        </group>
                        <group string="Other Information">
                            <field name="l10n_pt_description_on_payslip" />
                            <field
                                name="l10n_pt_affects_income_tax"
                                readonly="l10n_pt_standard_rule"
                            />
                            <field
                                name="l10n_pt_affects_temr"
                                readonly="l10n_pt_standard_rule"
                            />
                            <field
                                name="l10n_pt_affects_holiday_allowance"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_affects_christmas_allowance"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_affects_hourly_wage"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_affects_overtime_hourly_wage"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_affects_holiday"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_monthly_income"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_proportional_allowance"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_paid_in_kind"
                                readonly="l10n_pt_standard_rule"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_proportional_allowance"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                            <field
                                name="l10n_pt_paid_in_kind"
                                readonly="l10n_pt_standard_rule"
                                invisible="l10n_pt_category_code != 'ABONO'"
                            />
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath
                expr="//page[@name='accounting']//field[@name='account_credit']"
                position="after"
            >
                <field
                    name="l10n_pt_account_debit_corporate_body"
                    invisible="country_code != 'PT'"
                />
                <field
                    name="l10n_pt_account_credit_corporate_body"
                    invisible="country_code != 'PT'"
                />
            </xpath>

            <field name="code" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="condition_python" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="amount_python_compute" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="condition_select" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="amount_select" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="l10n_pt_dri_subject_amount" position="attributes">
                <attribute
                    name="readonly"
                >l10n_pt_standard_rule and code not in ['IND_CESS_CONT', 'IND_CESS_CONT_NAO_SS_SUJ_IRS', 'IND_CESS_CONT_NAO_SS_NAO_IRS']</attribute>
            </field>
            <field name="l10n_pt_dmr_subject_amount" position="attributes">
                <attribute
                    name="readonly"
                >l10n_pt_standard_rule and code not in ['IND_CESS_CONT', 'IND_CESS_CONT_NAO_SS_SUJ_IRS', 'IND_CESS_CONT_NAO_SS_NAO_IRS']</attribute>
            </field>
            <field name="l10n_pt_dmr_exempt_amount" position="attributes">
                <attribute name="readonly">
                    l10n_pt_standard_rule and code not in ['IND_CESS_CONT', 'IND_CESS_CONT_NAO_SS_SUJ_IRS', 'IND_CESS_CONT_NAO_SS_NAO_IRS']</attribute>
            </field>
            <field name="sequence" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="appears_on_payslip" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="category_id" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
            <field name="struct_id" position="attributes">
                <attribute name="readonly">l10n_pt_standard_rule</attribute>
            </field>
        </field>
    </record>
</odoo>
