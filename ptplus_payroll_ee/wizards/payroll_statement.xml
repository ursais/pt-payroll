<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="wizard_payroll_statement_form" model="ir.ui.view">
        <field name="name">payroll.statement.wizard.pt.form</field>
        <field name="model">payroll.statement.wizard.pt</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="ptplus_payroll.wizard_payroll_statement_form" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="first_decl_replacement_decl" position="after">
            </field>
        </field>
    </record>

    <record id="action_wizard_payroll_statement" model="ir.actions.act_window">
        <field name="name">Payroll Statements</field>
        <field name="res_model">payroll.statement.wizard.pt</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ptplus_payroll_ee.wizard_payroll_statement_form" />
        <field name="target">new</field>
    </record>

    <!-- Reports -->
    <menuitem
        id="wizard_payroll_statement_menu"
        parent="payroll_menu_report_pt"
        groups="hr_payroll.group_hr_payroll_user"
        action="ptplus_payroll_ee.action_wizard_payroll_statement"
    />
</odoo>
