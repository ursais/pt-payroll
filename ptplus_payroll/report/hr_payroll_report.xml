<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_report_payslip_pt" model="ir.actions.report">
        <field name="name">PT: Recibo de Vencimento</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ptplus_payroll.report_payslip_pt_lang</field>
        <field name="report_file">ptplus_payroll.report_payslip_pt_lang</field>
        <field
            name="print_report_name"
        >'Recibo de Vencimento - %s' % (object.employee_id.name)</field>
        <field name="binding_type">report</field>
        <!-- Erase fields to avoid double PDF posting -->
        <field name="attachment" />
        <field name="attachment_use" eval="False" />
    </record>
</odoo>
