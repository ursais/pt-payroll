<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_social_security_tax_pt_view_search" model="ir.ui.view">
        <field name="name">hr.social.security.tax.pt.search</field>
        <field name="model">hr.social.security.tax.pt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="company_tax_rate" />
                <field name="employee_tax_rate" />
                <field name="notes" />
            </search>
        </field>
    </record>

    <record id="hr_social_security_tax_pt_view_tree" model="ir.ui.view">
        <field name="name">hr.social.security.tax.pt.list</field>
        <field name="model">hr.social.security.tax.pt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_tax_rate" />
                <field name="employee_tax_rate" />
                <field name="notes" />
            </list>
        </field>
    </record>

    <record id="hr_social_security_tax_pt_view_form" model="ir.ui.view">
        <field name="name">hr.social.security.tax.pt.form</field>
        <field name="model">hr.social.security.tax.pt</field>
        <field name="arch" type="xml">
            <form string="Social Security Tax">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="company_tax_rate" />
                        <field name="employee_tax_rate" />
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_social_security_tax_pt_action" model="ir.actions.act_window">
        <field name="name">Social Security Taxes</field>
        <field name="res_model">hr.social.security.tax.pt</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="hr_social_security_tax_pt_view_tree" />
        <field name="search_view_id" ref="hr_social_security_tax_pt_view_search" />
    </record>

   <menuitem
        id="menu_hr_social_security_tax_pt_action"
        action="hr_social_security_tax_pt_action"
        sequence="4"
    />
</odoo>
