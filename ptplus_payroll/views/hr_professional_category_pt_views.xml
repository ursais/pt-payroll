<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_professional_category_pt_view_search" model="ir.ui.view">
        <field name="name">hr.professional.category.pt.search</field>
        <field name="model">hr.professional.category.pt</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="hr_professional_category_pt_view_tree" model="ir.ui.view">
        <field name="name">hr.professional.category.pt.tree</field>
        <field name="model">hr.professional.category.pt</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="hr_professional_category_pt_view_form" model="ir.ui.view">
        <field name="name">hr.professional.category.pt.form</field>
        <field name="model">hr.professional.category.pt</field>
        <field name="arch" type="xml">
            <form string="Professional Category">
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_professional_category_pt_action" model="ir.actions.act_window">
        <field name="name">Professional Category</field>
        <field name="res_model">hr.professional.category.pt</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="hr_professional_category_pt_view_tree" />
        <field name="search_view_id" ref="hr_professional_category_pt_view_search" />
    </record>

    <menuitem
        id="menu_hr_professional_category_action"
        action="hr_professional_category_pt_action"
        sequence="7"
    />
</odoo>
