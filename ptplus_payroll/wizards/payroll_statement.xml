<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="wizard_payroll_statement_form" model="ir.ui.view">
        <field name="name">payroll.statement.wizard.pt.form</field>
        <field name="model">payroll.statement.wizard.pt</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="ptplus.dataport_export_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <!--DMR fields-->
                <field name="statement_type" />
                <field
                    name="first_decl_replacement_decl"
                    attrs="{'invisible': [('statement_type','!=', 'payroll.dmr')]}"
                />
                <field
                    name="declaration_presented_under"
                    attrs="{'invisible': [('statement_type','!=', 'payroll.dmr')]}"
                />
                <field
                    name="date_that_determined_the_obligation_to_declare"
                    attrs="{'invisible': [('declaration_presented_under','!=', True)]}"
                />
                <field
                    name="determines_fair_impediment"
                    attrs="{'invisible': [('statement_type','!=', 'payroll.dmr')]}"
                />
                <field
                    name="date_of_occurrence"
                    attrs="{'invisible': [('determines_fair_impediment','!=', True)]}"
                />
                <field
                    name="date_of_assignment"
                    attrs="{'invisible': [('determines_fair_impediment','!=', True)]}"
                />
                <!--Holiday Sheets fields-->
                <field
                    name="l10n_pt_insurance"
                    attrs="{'invisible': [('statement_type','!=', 'payroll.holiday_sheets')]}"
                />
                <!--Annual Income Statement fields-->
                <field
                    name="employee_ids"
                    attrs="{'invisible': [('statement_type','!=', 'payroll.annual_income_stmt')]}"
                    widget="many2many_tags"
                />
            </field>
        </field>
    </record>

</odoo>
